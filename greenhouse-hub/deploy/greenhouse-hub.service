[Unit]
Description=Greenhouse Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=greenhouse
Group=greenhouse
WorkingDirectory=/opt/greenhouse-hub
ExecStart=/opt/greenhouse-hub/greenhouse-hub \
  --serial /dev/ttyUSB0 \
  --baud 115200 \
  --topology /etc/greenhouse/topology.json \
  --semantics /etc/greenhouse/semantics.json \
  --listen 0.0.0.0:8080
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
