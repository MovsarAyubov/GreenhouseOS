{
  "schema": "greenhouse_slave_map_v1",
  "name": "Zone Slave Map v1",
  "device_type": 1,
  "device_type_name": "Zone Slave",
  "modbus_map_version": 1,
  "addressing": "zero_based_holding_register",
  "deprecated_aliases_supported": false,
  "ranges": [
    {"from": 0, "to": 99, "purpose": "common identity/status/diagnostics"},
    {"from": 100, "to": 399, "purpose": "reserved/common service"},
    {"from": 400, "to": 699, "purpose": "telemetry/status by device type"},
    {"from": 700, "to": 999, "purpose": "calculated state/statistics"},
    {"from": 1000, "to": 1299, "purpose": "setpoints/commands from hub"},
    {"from": 1300, "to": 1599, "purpose": "schedules/profiles"},
    {"from": 1600, "to": 1799, "purpose": "shared external data"},
    {"from": 1800, "to": 1999, "purpose": "advanced diagnostics/debug"}
  ],
  "common": [
    {"reg": 0, "key": "device_type", "type": "u16", "access": "r"},
    {"reg": 1, "key": "firmware_version", "type": "u16", "access": "r", "format": "major << 8 | minor"},
    {"reg": 2, "key": "modbus_map_version", "type": "u16", "access": "r"},
    {"reg": 3, "key": "zone_id", "type": "u16", "access": "r", "note": "current slave_id in v1 zone firmware"},
    {"reg": 4, "key": "capability_low", "type": "u16", "access": "r"},
    {"reg": 5, "key": "capability_high", "type": "u16", "access": "r"},
    {"reg": 6, "key": "status_bits", "type": "u16", "access": "r"},
    {"reg": 7, "key": "fault_code", "type": "u16", "access": "r"},
    {"reg": 8, "key": "uptime_hi", "type": "u16", "access": "r"},
    {"reg": 9, "key": "uptime_lo", "type": "u16", "access": "r"},
    {"reg": 10, "key": "last_master_age_s", "type": "u16", "access": "r", "unit": "s"},
    {"reg": 11, "key": "restart_counter", "type": "u16", "access": "r"},
    {"reg": 12, "key": "config_version", "type": "u16", "access": "r"},
    {"reg": 13, "key": "serial_hi", "type": "u16", "access": "r"},
    {"reg": 14, "key": "serial_lo", "type": "u16", "access": "r"},
    {"reg": 15, "key": "identity_crc", "type": "u16", "access": "r", "default": 0},
    {"reg": 32, "key": "diag_timeout_count", "type": "u16", "access": "r"},
    {"reg": 33, "key": "diag_crc_error_count", "type": "u16", "access": "r"},
    {"reg": 34, "key": "diag_exception_count", "type": "u16", "access": "r"},
    {"reg": 35, "key": "diag_last_exception", "type": "u16", "access": "r"},
    {"reg": 36, "key": "diag_rx_count_hi", "type": "u16", "access": "r"},
    {"reg": 37, "key": "diag_rx_count_lo", "type": "u16", "access": "r"},
    {"reg": 38, "key": "diag_tx_count_hi", "type": "u16", "access": "r"},
    {"reg": 39, "key": "diag_tx_count_lo", "type": "u16", "access": "r"}
  ],
  "capabilities": [
    {"bit": 0, "key": "air_temperature"},
    {"bit": 1, "key": "air_humidity"},
    {"bit": 2, "key": "co2"},
    {"bit": 3, "key": "water_rail_temperature"},
    {"bit": 4, "key": "water_grow_temperature"},
    {"bit": 5, "key": "water_undertray_temperature"},
    {"bit": 6, "key": "water_upper_heat_temperature"},
    {"bit": 7, "key": "windows_group_a"},
    {"bit": 8, "key": "windows_group_b"},
    {"bit": 9, "key": "curtain"},
    {"bit": 10, "key": "heating_output"},
    {"bit": 11, "key": "lighting_output"},
    {"bit": 12, "key": "weather_sync_input"},
    {"bit": 13, "key": "autonomous_mode"},
    {"bit": 14, "key": "manual_mode"},
    {"bit": 15, "key": "emergency_stop"}
  ],
  "telemetry": [
    {"reg": 400, "key": "air_temp", "type": "s16", "scale": 0.1, "unit": "degC", "access": "r", "capability_bit": 0},
    {"reg": 401, "key": "air_humidity", "type": "u16", "scale": 0.1, "unit": "%RH", "access": "r", "capability_bit": 1},
    {"reg": 402, "key": "co2", "type": "u16", "scale": 1, "unit": "ppm", "access": "r", "capability_bit": 2},
    {"reg": 403, "key": "water_rail_temp", "type": "s16", "scale": 0.1, "unit": "degC", "access": "r", "capability_bit": 3},
    {"reg": 404, "key": "water_grow_temp", "type": "s16", "scale": 0.1, "unit": "degC", "access": "r", "capability_bit": 4},
    {"reg": 405, "key": "water_undertray_temp", "type": "s16", "scale": 0.1, "unit": "degC", "access": "r", "capability_bit": 5},
    {"reg": 406, "key": "water_upper_heat_temp", "type": "s16", "scale": 0.1, "unit": "degC", "access": "r", "capability_bit": 6},
    {"reg": 407, "key": "windows_a_position", "type": "u16", "scale": 0.1, "unit": "%", "access": "r", "capability_bit": 7},
    {"reg": 408, "key": "windows_b_position", "type": "u16", "scale": 0.1, "unit": "%", "access": "r", "capability_bit": 8},
    {"reg": 409, "key": "curtain_position", "type": "u16", "scale": 0.1, "unit": "%", "access": "r", "capability_bit": 9},
    {"reg": 410, "key": "heating_output", "type": "u16", "scale": 0.1, "unit": "%", "access": "r", "capability_bit": 10},
    {"reg": 411, "key": "light_output", "type": "u16", "scale": 0.1, "unit": "%", "access": "r", "capability_bit": 11, "examples": [0, 500, 1000]},
    {"reg": 413, "key": "vpd", "type": "u16", "scale": 0.01, "unit": "kPa", "access": "r", "reserved": true},
    {"reg": 414, "key": "current_dli_hi", "type": "u16", "access": "r"},
    {"reg": 415, "key": "current_dli_lo", "type": "u16", "access": "r"},
    {"reg": 416, "key": "zone_state_bits", "type": "u16", "access": "r"},
    {"reg": 417, "key": "sensor_fault_bits", "type": "u16", "access": "r"},
    {"reg": 418, "key": "actuator_fault_bits", "type": "u16", "access": "r"}
  ],
  "setpoints_commands": [
    {"from": 1000, "to": 1014, "key": "command_setpoint_payload", "access": "rw"},
    {"reg": 1015, "key": "command_token", "type": "u16", "access": "rw"},
    {"reg": 1016, "key": "applied_token", "type": "u16", "access": "r"},
    {"reg": 1017, "key": "command_result", "type": "u16", "access": "r"},
    {"from": 1020, "to": 1023, "key": "water_setpoints", "scale": 0.1, "unit": "degC", "access": "rw"},
    {"from": 1030, "to": 1069, "key": "windows_and_greenhouse_settings", "access": "rw"},
    {"from": 1100, "to": 1111, "key": "heating_controls", "access": "rw"},
    {"from": 1130, "to": 1154, "key": "curtain_controls", "access": "rw"},
    {"from": 1160, "to": 1161, "key": "greenhouse_air_targets", "access": "rw"},
    {"from": 1170, "to": 1196, "key": "co2_controls_and_sensor_inputs", "access": "rw"},
    {"from": 1210, "to": 1219, "key": "circulation_controls", "access": "rw"},
    {"from": 1230, "to": 1237, "key": "side_curtain_controls", "access": "rw"}
  ],
  "schedules_profiles": [
    {"reg": 1300, "key": "light_r1_enable", "type": "u16", "access": "rw"},
    {"reg": 1301, "key": "light_r1_on_hhmm", "type": "u16", "access": "rw"},
    {"reg": 1302, "key": "light_r1_off_hhmm", "type": "u16", "access": "rw"},
    {"reg": 1303, "key": "light_r1_threshold_wm2", "type": "u16", "unit": "W/m2", "access": "rw"},
    {"reg": 1305, "key": "light_r1_dli_off_limit_jcm2", "type": "u16", "unit": "J/cm2", "access": "rw"},
    {"reg": 1306, "key": "light_r2_enable", "type": "u16", "access": "rw"},
    {"reg": 1307, "key": "light_r2_on_hhmm", "type": "u16", "access": "rw"},
    {"reg": 1308, "key": "light_r2_off_hhmm", "type": "u16", "access": "rw"},
    {"reg": 1309, "key": "light_r2_threshold_wm2", "type": "u16", "unit": "W/m2", "access": "rw"},
    {"reg": 1311, "key": "light_r2_dli_off_limit_jcm2", "type": "u16", "unit": "J/cm2", "access": "rw"},
    {"reg": 1312, "key": "light_hyst_sec", "type": "u16", "unit": "s", "access": "rw"}
  ],
  "shared_external_data": [
    {"reg": 1600, "key": "weather_out_temp", "type": "s16", "scale": 0.1, "unit": "degC", "access": "rw"},
    {"reg": 1601, "key": "weather_out_humidity", "type": "u16", "scale": 0.1, "unit": "%RH", "access": "rw"},
    {"reg": 1602, "key": "weather_wind_speed", "type": "u16", "scale": 0.1, "unit": "m/s", "access": "rw"},
    {"reg": 1603, "key": "weather_wind_dir", "type": "u16", "scale": 1, "unit": "deg", "access": "rw"},
    {"reg": 1604, "key": "weather_rain_flag", "type": "u16", "access": "rw"},
    {"reg": 1605, "key": "weather_solar_rad", "type": "u16", "scale": 1, "unit": "W/m2", "access": "rw"},
    {"reg": 1606, "key": "weather_baro_press", "type": "u16", "scale": 0.1, "unit": "hPa", "access": "rw"},
    {"reg": 1607, "key": "weather_dew_point", "type": "s16", "scale": 0.1, "unit": "degC", "access": "rw"},
    {"reg": 1608, "key": "weather_status_bits", "type": "u16", "access": "rw"},
    {"reg": 1609, "key": "weather_age_s", "type": "u16", "unit": "s", "access": "rw"},
    {"reg": 1610, "key": "weather_token", "type": "u16", "access": "rw"},
    {"reg": 1611, "key": "weather_applied_token", "type": "u16", "access": "r"},
    {"reg": 1612, "key": "weather_result", "type": "u16", "access": "r"},
    {"reg": 1613, "key": "light_current_dli_jcm2", "type": "u16", "unit": "J/cm2", "access": "rw"}
  ],
  "advanced_diagnostics": [
    {"reg": 1800, "key": "rtc_set_hour", "type": "u16", "access": "rw"},
    {"reg": 1801, "key": "rtc_set_minute", "type": "u16", "access": "rw"},
    {"reg": 1802, "key": "rtc_set_token", "type": "u16", "access": "rw"},
    {"reg": 421, "key": "rtc_set_applied_token", "type": "u16", "access": "r"},
    {"reg": 422, "key": "rtc_set_result", "type": "u16", "access": "r"}
  ],
  "write_policy": {
    "writable_ranges": [
      {"from": 1000, "to": 1015},
      {"from": 1020, "to": 1299},
      {"from": 1300, "to": 1599},
      {"from": 1600, "to": 1610},
      {"from": 1613, "to": 1613},
      {"from": 1800, "to": 1802}
    ],
    "read_only_ranges": [
      {"from": 0, "to": 99},
      {"from": 400, "to": 999},
      {"from": 1016, "to": 1017},
      {"from": 1611, "to": 1612},
      {"from": 1803, "to": 1999}
    ]
  }
}
